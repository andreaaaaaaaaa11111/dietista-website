# ============================================================
# VARIABILI D'AMBIENTE - Studio Dietista Arianna Pelliccioni
# ============================================================
# Copiare questo file in .env e compilare tutti i valori.
# NON committare il file .env nel repository.
# ============================================================

# ============================================================
# DATABASE (TiDB Serverless)
# ============================================================
# Ottenere da: https://tidbcloud.com → Connect → Connection String
# Usare il piano Starter (gratuito). Porta: 4000, SSL obbligatorio.
DATABASE_URL="mysql://username:password@gateway01.eu-central-1.prod.aws.tidbcloud.com:4000/sys"

# ============================================================
# AUTENTICAZIONE (Clerk)
# ============================================================
# Ottenere da: https://dashboard.clerk.com → API Keys
CLERK_SECRET_KEY="sk_live_..."
CLERK_WEBHOOK_SECRET="whsec_..."

# Chiave pubblica Clerk per il frontend (inizia con pk_)
# Ottenere da: https://dashboard.clerk.com → API Keys
VITE_CLERK_PUBLISHABLE_KEY="pk_live_..."

# ============================================================
# STORAGE (Cloudinary)
# ============================================================
# Ottenere da: https://cloudinary.com/console → Dashboard
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="your-api-secret"

# ============================================================
# EMAIL (SendGrid) - Opzionale
# ============================================================
# Ottenere da: https://app.sendgrid.com → Settings → API Keys
# Necessario solo per notifiche email (es. conferma consulenze)
SENDGRID_API_KEY="SG...."

# ============================================================
# AI (OpenAI) - Opzionale
# ============================================================
# Ottenere da: https://platform.openai.com/api-keys
# Necessario solo per la generazione automatica di articoli blog
OPENAI_API_KEY="sk-..."

# ============================================================
# STRIPE - Opzionale
# ============================================================
# Ottenere da: https://dashboard.stripe.com → Developers → API Keys
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
VITE_STRIPE_PUBLISHABLE_KEY="pk_live_..."

# ============================================================
# CONFIGURAZIONE APP
# ============================================================
# Email del proprietario del sito (per notifiche admin)
OWNER_EMAIL="pelliccioniarianna.dietista@gmail.com"

# JWT Secret per sessioni (generare con: openssl rand -base64 32)
JWT_SECRET="your-random-secret-here"

# ============================================================
# NOTE IMPORTANTI
# ============================================================
# 
# Per il deploy su Vercel (frontend):
# - Aggiungere solo le variabili VITE_* e CLERK_SECRET_KEY
# - Configurare il rewrite /api/* → Railway backend URL
#
# Per il deploy su Railway (backend):
# - Aggiungere tutte le variabili (eccetto VITE_*)
# - Railway fornisce automaticamente PORT
#
# Ordine di configurazione consigliato:
# 1. Creare database su PlanetScale
# 2. Creare applicazione su Clerk
# 3. Creare account Cloudinary
# 4. Deploy backend su Railway con tutte le variabili
# 5. Configurare webhook Clerk → URL Railway /api/clerk/webhook
# 6. Deploy frontend su Vercel con VITE_* e URL Railway
